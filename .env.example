# ---------------------------------------------------------------------------
# Kết nối SQL Server.
# Database QLSA chứa các bảng cấu hình SA_* và toàn bộ stored procedure.
# Dữ liệu chấm ăn gốc được đọc cross-database từ [BioStar] trên CÙNG instance.
# ---------------------------------------------------------------------------
DB_SERVER=10.70.22.240
DB_PORT=1433
DB_DATABASE=QLSA
DB_USER=sa
# Luôn để mật khẩu trong nháy kép — dotenv coi ký tự # ngoài chuỗi là comment.
DB_PASSWORD="MY_DB_PASSWORD"
DB_ENCRYPT=false

# Cổng của API server (Vite proxy /api trỏ vào cổng này khi chạy dev)
PORT=4000

# ---------------------------------------------------------------------------
# Đăng nhập. Cả ba biến đều CÓ MẶC ĐỊNH, không khai báo vẫn chạy đúng.
# ---------------------------------------------------------------------------
# Số ngày giữ phiên khi người dùng tick "Ghi nhớ đăng nhập".
# Đổi ở đây thì sửa luôn REMEMBER_DAYS trong src/App.tsx (chỉ để hiển thị).
AUTH_SESSION_DAYS=7

# Số giờ giữ phiên khi KHÔNG tick "Ghi nhớ đăng nhập".
AUTH_SHORT_SESSION_HOURS=12

# Chỉ bật true khi site đã chạy HTTPS. Bật lúc còn chạy HTTP thì trình duyệt
# bỏ luôn cookie phiên và KHÔNG AI ĐĂNG NHẬP ĐƯỢC.
AUTH_SECURE_COOKIE=false
